    "id": "s3_logging_target",
    "version": "1.0.0",
    "kind": "resource",
    "resource_type": "aws_s3_bucket",
    "reads": ["bucket", "tags.owner"],
    "presence_mode": "configured",
    "on": ["create"],
    "expr": "self.bucket != '' && size(self.tags) > 0",
    "action": "warn",
    "severity": "low",
    "message": "bucket <name> & \"owner\" tag: ü",
    "fix": "set the owner tag\tand logging",
    "framework_refs": ["cis:2.1.1", "nist:AC-3"],
    "tool_refs": {"checkov": ["CKV_AWS_18"], "aws_config": ["s3-bucket-logging-enabled", "x"]}
  },
  {
    "id": "s3_logging_companion",
    "version": "3.0.0",
    "kind": "graph",
    "resource_type": "aws_s3_bucket",
    "graph": {
      "rule": "companion_present",
      "companion_type": "aws_s3_bucket_logging",
      "link_attr": "bucket",
      "target_attrs": ["id", "bucket"],
      "companion_expr": "self.target_bucket != ''"
    },
    "action": "deny",
    "severity": "medium",
    "message": "logging companion required",
    "exemption_coverable": ["baseline", "grant"]
  },
  {
    "id": "rds_keep",
    "version": "1.2.3",
    "kind": "deletion_guard",
    "resource_type": "aws_db_instance",
    "reads": ["deletion_protection"],
    "on": ["delete"],
    "expr": "false",
    "action": "deny",
    "severity": "critical",
    "message": "do not delete",
    "exemption_coverable": ["break_glass"]
  }
]
