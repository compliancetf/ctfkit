{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.tf/schema/cff-1.schema.json",
  "title": "CTF Findings Format 1 (SARIF 2.1.0 profile)",
  "description": "CFF is SARIF 2.1.0 plus a Terraform profile: a ctf.* property bag on every result and run-level ctf.* properties. This schema constrains the SARIF subset ctfkit by compliance.tf emits and the profile on top of it; SARIF objects stay open (additionalProperties), so anything the SARIF specification allows and this profile does not name still validates. Full structural SARIF validation is the job of the official schema at https://json.schemastore.org/sarif-2.1.0.json, which this document deliberately does not $ref because schemacheck runs offline.",
  "type": "object",
  "required": ["version", "runs"],
  "properties": {
    "$schema": { "const": "https://json.schemastore.org/sarif-2.1.0.json" },
    "version": { "const": "2.1.0" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["tool", "results"],
      "properties": {
        "tool": {
          "type": "object",
          "required": ["driver"],
          "properties": {
            "driver": {
              "type": "object",
              "required": ["name", "rules"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "informationUri": { "type": "string", "format": "uri" },
                "rules": { "type": "array", "items": { "$ref": "#/$defs/reportingDescriptor" } }
              }
            }
          }
        },
        "properties": {
          "type": "object",
          "description": "The run-level property bag. Every key is optional; ctf.watermark is present only when --watermark set a banner line.",
          "properties": {
            "ctf.watermark": {
              "type": "string",
              "pattern": "^[^\u0000-\u001f\u007f]+$",
              "description": "The optional banner line --watermark sets: one line of printable text."
            },
            "ctf.catalogVersion": {
              "type": "object",
              "description": "Which control catalog the run read, so a reader can tell a finding produced from the embedded catalog from one produced against a vendored file.",
              "required": ["version", "origin"],
              "properties": {
                "version": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
                  "description": "The catalog version value, the semver.org grammar, the same pattern catalog-1 puts on its own version field."
                },
                "origin": {
                  "enum": ["embedded", "file", "home"],
                  "description": "embedded: built into the binary. file: named by --catalog. home: found at the home path."
                }
              }
            },
            "ctf.settings": {
              "type": "object",
              "description": "The policy inputs the repository settings file supplied, recorded so a reader can see what the scanned repository was allowed to change. Settings can never add or change control ids, rule ids, remediation or the remediation host.",
              "properties": {
                "endpoints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "fail_on": { "enum": ["error", "warning", "note", "never"] },
                "allowed_resources": { "type": "array", "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        },
        "results": { "type": "array", "items": { "$ref": "#/$defs/result" } }
      }
    },
    "reportingDescriptor": {
      "type": "object",
      "required": ["id", "shortDescription", "defaultConfiguration"],
      "properties": {
        "id": { "$ref": "#/$defs/ruleId" },
        "shortDescription": { "$ref": "#/$defs/message" },
        "help": { "$ref": "#/$defs/message" },
        "defaultConfiguration": {
          "type": "object",
          "required": ["level"],
          "properties": { "level": { "$ref": "#/$defs/level" } }
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["ruleId", "level", "kind", "message", "properties"],
      "properties": {
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "level": { "$ref": "#/$defs/level" },
        "kind": { "enum": ["pass", "fail", "open", "review", "informational", "notApplicable"] },
        "message": { "$ref": "#/$defs/message" },
        "locations": { "type": "array", "items": { "$ref": "#/$defs/location" } },
        "partialFingerprints": {
          "type": "object",
          "description": "Stable result identity for SARIF consumers. ctfkit writes ctfkitFindingHash/v1: sha256 of rule id, artifact uri, subject, control ids and an analyzer discriminator, never a line or message text.",
          "additionalProperties": { "type": "string" },
          "properties": {
            "ctfkitFindingHash/v1": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "suppressions": {
          "type": "array",
          "description": "Present when an approved exception covers the finding. Suppression is advisory at schema level; enforcement is the platform's approval flow.",
          "items": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["inSource", "external"] },
              "justification": { "type": "string", "minLength": 1 }
            }
          }
        },
        "properties": { "$ref": "#/$defs/ctfPropertyBag" }
      }
    },
    "ctfPropertyBag": {
      "type": "object",
      "description": "The ctf.* bag every conformant result carries. Keys are flat dotted names, not a nested ctf object.",
      "required": ["ctf.schema", "ctf.controlIds", "ctf.frameworks", "ctf.preventive", "ctf.stage"],
      "properties": {
        "ctf.schema": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$",
          "description": "The CFF version this result conforms to. 1.0 at launch."
        },
        "ctf.controlIds": {
          "type": "array",
          "description": "Control catalog ids. The join key across prevent, detect and evidence.",
          "items": { "type": "string", "minLength": 1 }
        },
        "ctf.frameworks": {
          "type": "array",
          "description": "Empty means framework agnostic.",
          "items": {
            "type": "object",
            "required": ["id", "clauses"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "clauses": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "supportingClauses": {
                "type": "array",
                "description": "The clauses a manifest at schema 3.4 or later marked as supporting evidence: partial or indirect, never full enforcement. Absent means unknown (the source does not classify), never that nothing is hedged; an empty list means classified and nothing hedged.",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "ctf.preventive": {
          "type": "boolean",
          "description": "True when a compliance.tf module would have prevented this at source."
        },
        "ctf.stage": { "$ref": "#/$defs/stage" },
        "ctf.attributes": {
          "type": "array",
          "minItems": 1,
          "description": "The attribute names this finding concerns, never their values. Plan and configuration values never enter a finding, so this carries names only, and it is omitted rather than written empty when the finding concerns no particular attribute.",
          "items": { "type": "string", "minLength": 1 }
        },
        "ctf.remediation": {
          "type": "object",
          "required": ["moduleSource"],
          "properties": {
            "moduleSource": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "diff": { "type": "string" }
          }
        },
        "ctf.exception": {
          "type": "object",
          "required": ["allowed"],
          "properties": {
            "allowed": { "type": "boolean" },
            "ttlSeconds": { "type": "integer", "minimum": 0 },
            "requiresJustification": { "type": "boolean" }
          }
        },
        "ctf.evidence": {
          "type": "object",
          "required": ["runId", "commit"],
          "properties": {
            "runId": { "type": "string" },
            "commit": { "type": "string" },
            "signature": {
              "type": ["string", "null"],
              "description": "Open source output emits null. A signature is additive: unsigned output stays valid when one is added."
            }
          }
        }
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "physicalLocation": {
          "type": "object",
          "required": ["artifactLocation"],
          "properties": {
            "artifactLocation": {
              "type": "object",
              "required": ["uri"],
              "properties": { "uri": { "type": "string", "minLength": 1 } }
            },
            "region": {
              "type": "object",
              "properties": {
                "startLine": { "type": "integer", "minimum": 1 },
                "startColumn": { "type": "integer", "minimum": 1 },
                "endLine": { "type": "integer", "minimum": 1 },
                "endColumn": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "logicalLocations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fullyQualifiedName"],
            "properties": {
              "fullyQualifiedName": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "taxonomy": {
      "type": "array",
      "description": "Input shape for the taxonomy generator: CFF ships a SARIF taxonomy enumerating every control id, rebuilt from the Control Catalog on each release. Nothing in the fixture pack carries one yet, so this definition is the contract the generator writes against.",
      "items": {
        "type": "object",
        "required": ["id", "name", "shortDescription", "defaultConfiguration"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "shortDescription": { "$ref": "#/$defs/message" },
          "defaultConfiguration": {
            "type": "object",
            "required": ["level"],
            "properties": { "level": { "$ref": "#/$defs/level" } }
          },
          "properties": {
            "type": "object",
            "properties": {
              "ctf.frameworks": {
                "type": "array",
                "description": "framework:clause pairs, for example soc_2:CC6.1.",
                "items": { "type": "string", "pattern": "^[^:]+:.+$" }
              }
            }
          }
        }
      }
    },
    "message": {
      "type": "object",
      "required": ["text"],
      "properties": { "text": { "type": "string", "minLength": 1 } }
    },
    "stage": { "enum": ["pre_plan", "post_init", "post_plan", "pre_apply", "post_apply"] },
    "level": { "enum": ["error", "warning", "note", "none"] },
    "ruleId": { "type": "string", "pattern": "^ctf\\.[a-z0-9]+(\\.[a-z0-9_]+)+$" }
  }
}
