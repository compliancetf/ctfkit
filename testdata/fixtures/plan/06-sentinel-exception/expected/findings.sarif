{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ctfkit",
          "informationUri": "https://github.com/compliancetf/ctfkit",
          "version": "1.0.0",
          "rules": [
            {
              "id": "ctf.coverage.module_source",
              "shortDescription": {
                "text": "Module sources outside compliance.tf endpoints, and raw resources a compliance.tf module covers"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ctf.coverage.module_source",
          "level": "error",
          "kind": "fail",
          "message": {
            "text": "Raw aws_s3_bucket where the compliance.tf module soc2.compliance.tf/terraform-aws-modules/s3-bucket/aws exists"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.tf"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 8
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "aws_s3_bucket.logs",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "ctfkitFindingHash/v1": "a4d280801bfbd88433b16832d21b060367bf59c2766495979246a8b9e1bd1539"
          },
          "properties": {
            "ctf.schema": "1.0",
            "ctf.stage": "post_plan",
            "ctf.controlIds": [],
            "ctf.frameworks": [],
            "ctf.preventive": true,
            "ctf.evidence": {
              "runId": "ctfkit-fixture-run",
              "commit": "0000000000000000000000000000000000000000",
              "signature": null
            },
            "ctf.remediation": {
              "moduleSource": "soc2.compliance.tf/terraform-aws-modules/s3-bucket/aws",
              "version": "~> 5.0"
            },
            "ctf.exception": {
              "allowed": true,
              "entryId": "SEC-4711",
              "justification": "Scratch bucket for ETL output. Objects are deleted within 24 hours, which object lock retention would block.",
              "ttlSeconds": 22031999
            }
          },
          "suppressions": [
            {
              "kind": "external",
              "justification": "Scratch bucket for ETL output. Objects are deleted within 24 hours, which object lock retention would block."
            }
          ]
