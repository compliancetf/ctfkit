{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ctfkit",
          "informationUri": "https://github.com/compliancetf/ctfkit",
          "version": "1.0.0",
          "rules": [
            {
              "id": "ctf.risk.sensitive_change_destructive_stateful",
              "shortDescription": {
                "text": "A change deletes or replaces a stateful resource, or removes its deletion safeguard"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "ctf.risk.sensitive_change_encryption_disablement",
              "shortDescription": {
                "text": "A change turns off encryption at rest"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ctf.risk.sensitive_change_destructive_stateful",
          "level": "error",
          "kind": "fail",
          "message": {
            "text": "aws_db_instance.primary is replaced, which deletes the existing instance before the new one is created"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.tf"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 17
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "aws_db_instance.primary",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "ctfkitFindingHash/v1": "70540511fbbb1bc0649f64afbd95bd532a6b3d2a8f2ae6993d0ba3408fe827e3"
          },
          "properties": {
            "ctf.schema": "1.0",
            "ctf.stage": "post_plan",
            "ctf.controlIds": [],
            "ctf.frameworks": [],
            "ctf.preventive": false,
            "ctf.evidence": {
              "runId": "ctfkit-fixture-run",
              "commit": "0000000000000000000000000000000000000000",
              "signature": null
            },
            "ctf.attributes": [
              "storage_encrypted"
            ]
          }
        },
        {
          "ruleId": "ctf.risk.sensitive_change_encryption_disablement",
          "level": "error",
          "kind": "fail",
          "message": {
            "text": "aws_s3_bucket_server_side_encryption_configuration.archive is deleted, which removes default encryption from its bucket"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.tf"
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "aws_s3_bucket_server_side_encryption_configuration.archive",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "ctfkitFindingHash/v1": "ddb64222dd38c58d8cf1f0ff329bc1af352f3f9e6ddc8fe77da16585ec58fe3a"
          },
          "properties": {
            "ctf.schema": "1.0",
            "ctf.stage": "post_plan",
            "ctf.controlIds": [],
            "ctf.frameworks": [],
            "ctf.preventive": false,
            "ctf.evidence": {
              "runId": "ctfkit-fixture-run",
              "commit": "0000000000000000000000000000000000000000",
              "signature": null
            }
          }
        },
        {
          "ruleId": "ctf.risk.sensitive_change_encryption_disablement",
          "level": "error",
          "kind": "fail",
          "message": {
            "text": "aws_db_instance.primary turns storage_encrypted from true to false"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.tf"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 17
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "aws_db_instance.primary",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "ctfkitFindingHash/v1": "07a59d21c565df1130f2d5c2f008dfc9055e20e03b8ce1305c0a8e1ef61d5b05"
          },
          "properties": {
            "ctf.schema": "1.0",
            "ctf.stage": "post_plan",
            "ctf.controlIds": [
              "rds_db_instance_encryption_at_rest_enabled"
            ],
            "ctf.frameworks": [
              {
                "id": "cis_v600",
                "clauses": [
                  "3",
                  "3.2"
                ]
              }
            ],
            "ctf.preventive": true,
            "ctf.evidence": {
              "runId": "ctfkit-fixture-run",
              "commit": "0000000000000000000000000000000000000000",
              "signature": null
            },
            "ctf.attributes": [
              "storage_encrypted"
            ]
          }
        }
      ]
    }
  ]
}
