{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ctfkit",
          "informationUri": "https://github.com/compliancetf/ctfkit",
          "version": "1.0.0",
          "rules": [
            {
              "id": "ctf.evidence.drift",
              "shortDescription": {
                "text": "The plan reports drift between the applied state and the configuration"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ctf.evidence.drift",
          "level": "warning",
          "kind": "fail",
          "message": {
            "text": "local_file.bucket_policy drifted from the applied state: content changed outside this configuration"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.tf"
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "local_file.bucket_policy",
                  "kind": "resource"
                }
              ]
            }
          ],
          "properties": {
            "ctf.schema": "1.0",
            "ctf.stage": "post_apply",
            "ctf.controlIds": [],
            "ctf.frameworks": [],
            "ctf.preventive": false,
            "ctf.evidence": {
              "runId": "ctfkit-fixture-run",
              "commit": "0000000000000000000000000000000000000000",
              "signature": null
            }
          }
        }
      ]
    }
  ]
}
