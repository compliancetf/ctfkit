                },
                "region": {
                  "startLine": 1,
                  "endLine": 3
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "random_pet.suffix",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "ctfkitFindingHash/v1": "6673ba4614b2e66d655f8f8768e3077d746674c7ddc955c94515873bceaddcdf"
          },
          "properties": {
            "ctf.schema": "1.0",
            "ctf.stage": "pre_plan",
            "ctf.controlIds": [],
            "ctf.frameworks": [],
            "ctf.preventive": false,
            "ctf.evidence": {
              "runId": "ctfkit-fixture-run",
              "commit": "0000000000000000000000000000000000000000",
              "signature": null
            }
          }
        }
      ]
    }
  ]
}
