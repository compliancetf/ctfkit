{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ctfkit",
          "informationUri": "https://github.com/compliancetf/ctfkit",
          "version": "1.0.0",
          "rules": [
            {
              "id": "ctf.risk.sensitive_change_destructive_stateful",
              "shortDescription": {
                "text": "A change deletes or replaces a stateful resource, or removes its deletion safeguard"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ctf.risk.sensitive_change_destructive_stateful",
          "level": "error",
          "kind": "fail",
          "message": {
            "text": "aws_dynamodb_table.sessions is replaced, which deletes the existing table before the new one is created"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.tf"
                },
                "region": {
                  "startLine": 4,
                  "endLine": 17
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "aws_dynamodb_table.sessions",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "ctfkitFindingHash/v1": "7250860a11f57db20b2887704012b4260f8bcd39fa16be2779ac6dd3c7a3be13"
          },
          "properties": {
            "ctf.schema": "1.0",
            "ctf.stage": "post_plan",
            "ctf.controlIds": [],
            "ctf.frameworks": [],
            "ctf.preventive": false,
            "ctf.evidence": {
              "runId": "ctfkit-fixture-run",
              "commit": "0000000000000000000000000000000000000000",
              "signature": null
            },
            "ctf.attributes": [
              "hash_key"
            ]
          }
        },
        {
          "ruleId": "ctf.risk.sensitive_change_destructive_stateful",
          "level": "warning",
          "kind": "fail",
          "message": {
            "text": "aws_db_instance.ledger turns deletion_protection from true to false"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.tf"
                },
                "region": {
                  "startLine": 35,
                  "endLine": 47
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "aws_db_instance.ledger",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "ctfkitFindingHash/v1": "c6e1e99c1ef5877c619b88b4d0fa85dc74a3ad7f1a818267fe35be0c4928ed59"
          },
          "properties": {
            "ctf.schema": "1.0",
            "ctf.stage": "post_plan",
            "ctf.controlIds": [],
            "ctf.frameworks": [],
            "ctf.preventive": false,
            "ctf.evidence": {
              "runId": "ctfkit-fixture-run",
              "commit": "0000000000000000000000000000000000000000",
              "signature": null
            },
            "ctf.attributes": [
              "deletion_protection"
            ]
          }
        }
      ]
    }
  ]
}
