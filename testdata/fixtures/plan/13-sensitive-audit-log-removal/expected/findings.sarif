{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ctfkit",
          "informationUri": "https://github.com/compliancetf/ctfkit",
          "version": "1.0.0",
          "rules": [
            {
              "id": "ctf.risk.sensitive_change_audit_log_removal",
              "shortDescription": {
                "text": "A change removes or narrows audit logging"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ctf.risk.sensitive_change_audit_log_removal",
          "level": "error",
          "kind": "fail",
          "message": {
            "text": "aws_cloudtrail.org is deleted, which stops the audit trail it records"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.tf"
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "aws_cloudtrail.org",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "ctfkitFindingHash/v1": "fa2da1737ab20fb3d412982d25474a512c12d4dd68ae9df868463d2c48956c5c"
          },
          "properties": {
            "ctf.schema": "1.0",
            "ctf.stage": "post_plan",
            "ctf.controlIds": [],
            "ctf.frameworks": [],
            "ctf.preventive": false,
            "ctf.evidence": {
              "runId": "ctfkit-fixture-run",
              "commit": "0000000000000000000000000000000000000000",
              "signature": null
            }
          }
        },
        {
          "ruleId": "ctf.risk.sensitive_change_audit_log_removal",
          "level": "error",
          "kind": "fail",
          "message": {
            "text": "aws_eks_cluster.platform narrows enabled_cluster_log_types to a strict subset of its prior value"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.tf"
                },
                "region": {
                  "startLine": 14,
                  "endLine": 24
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "aws_eks_cluster.platform",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "ctfkitFindingHash/v1": "a5efdc03d728b30d3809794a2ca79fde5e2e167abab34151a2dd4ae64643bdd2"
          },
          "properties": {
            "ctf.schema": "1.0",
            "ctf.stage": "post_plan",
            "ctf.controlIds": [],
            "ctf.frameworks": [],
            "ctf.preventive": false,
            "ctf.evidence": {
              "runId": "ctfkit-fixture-run",
              "commit": "0000000000000000000000000000000000000000",
              "signature": null
            },
            "ctf.attributes": [
              "enabled_cluster_log_types"
            ]
          }
        }
      ]
    }
  ]
}
