{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ctfkit",
          "informationUri": "https://github.com/compliancetf/ctfkit",
          "version": "1.0.0",
          "rules": [
            {
              "id": "ctf.coverage.delegation_unresolved",
              "shortDescription": {
                "text": "A delegated control has no instantiated sibling scope enforcing it"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "ctf.coverage.manifest_missing",
              "shortDescription": {
                "text": "An instantiated module has no compliancetf-manifest.json"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "properties": {
        "ctf.catalogVersion": {
          "version": "2026.11.1",
          "origin": "embedded"
        }
      },
      "results": [
        {
          "ruleId": "ctf.coverage.manifest_missing",
          "level": "error",
          "kind": "fail",
          "message": {
            "text": "Module instance replication_role (./modules/replication_role) has no compliancetf-manifest.json; it is listed as not-evidence, never as covered"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".terraform/modules/modules.json"
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "module.replication_role",
                  "kind": "module"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "ctfkitFindingHash/v1": "84a46462dc9d4927daa03bbbe50b88927b74a8281d6b1ea8fe37bf3b68dae975"
          },
          "properties": {
            "ctf.schema": "1.0",
            "ctf.stage": "post_init",
            "ctf.controlIds": [],
            "ctf.frameworks": [],
            "ctf.preventive": false,
            "ctf.evidence": {
              "runId": "ctfkit-fixture-run",
              "commit": "0000000000000000000000000000000000000000",
              "signature": null
            }
          }
        },
        {
          "ruleId": "ctf.coverage.delegation_unresolved",
          "level": "warning",
          "kind": "fail",
          "message": {
            "text": "Control s3_bucket_event_notifications_enabled is delegated to scope modules/notification of bobthecorp.compliance.tf/terraform-aws-modules/s3-bucket/aws 5.16.1-1e4b692ae5e0a847; no instantiated module instance governs that scope, so this configuration has no evidence the control is enforced; the control catalog 2026.11.1 does not hold this control id (the embedded catalog holds CIS v6.0 only), so the finding carries no control id"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".terraform/modules/modules.json"
                }
              }
            }
          ],
          "partialFingerprints": {
