              "commit": "0000000000000000000000000000000000000000",
              "signature": null
            }
          }
        },
        {
          "ruleId": "ctf.coverage.delegation_unresolved",
          "level": "warning",
          "kind": "fail",
          "message": {
            "text": "Control s3_public_access_block_account is delegated to scope modules/account-public-access of bobthecorp.compliance.tf/terraform-aws-modules/s3-bucket/aws 5.16.1-1e4b692ae5e0a847; no instantiated module instance governs that scope, so this configuration has no evidence the control is enforced; the control catalog 2026.11.1 does not hold this control id (the embedded catalog holds CIS v6.0 only), so the finding carries no control id"
          },
          "locations": [
