{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ctfkit",
          "informationUri": "https://github.com/compliancetf/ctfkit",
          "version": "1.0.0",
          "rules": [
            {
              "id": "ctf.coverage.delegation_unresolved",
              "shortDescription": {
                "text": "A delegated control has no instantiated sibling scope enforcing it"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "ctf.coverage.obligation_unknown",
              "shortDescription": {
                "text": "A manifest obligation token is not in the shipped list"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "ctf.coverage.posture_degraded",
              "shortDescription": {
                "text": "The served build reports a degraded posture"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "properties": {
        "ctf.catalogVersion": {
          "version": "2026.11.0",
          "origin": "embedded"
        }
      },
