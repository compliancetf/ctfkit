{
  "behavior": "B4",
  "assumption": "state replace-provider rewrites aliased (provider[\"...\"].west) and module-scoped resource provider addresses",
  "cli": {
    "name": "tofu",
    "version": "1.13.1",
    "platform": "darwin_arm64",
    "binary_sha256": "56b267df2cbe6498d6b1deedb9cbff038954dfc20830dfd51abea658fabbe586",
    "release_archive": "tofu_1.13.1_darwin_arm64.zip",
    "release_archive_sha256": "81aebe6453223bcb3ce3c28424b36d009ebfddd3ad65ad1ec3eed0d0d574a77b"
  },
  "fake_provider_sha256": "dcb0571f6084f1d074a3ae02e0a8df62158e5eeb49b80e32d921e1b424eb9437",
  "upstream": "registry.opentofu.org/hashicorp/aws",
  "inputs_sha256": "441115ad1e3190878e50b34dc93113d17ad38a649d989e8084da980a7faffb92",
  "steps": [
    {
      "dir": "root",
      "run": [
        "tofu",
        "init",
        "-input=false",
        "-no-color"
      ],
      "exit": 0,
      "output": [
        "",
        "Initializing the backend...",
        "",
        "Initializing provider plugins...",
        "- Finding latest version of hashicorp/aws...",
        "- Installing hashicorp/aws v6.0.0...",
        "- Installed hashicorp/aws v6.0.0 (unauthenticated)",
        "",
        "OpenTofu has created a lock file .terraform.lock.hcl to record the provider",
        "selections it made above. Include this file in your version control repository",
        "so that OpenTofu can guarantee to make the same selections by default when",
        "you run \"tofu init\" in the future.",
        "",
        "",
        "Warning: Incomplete lock file information for providers",
        "",
        "Due to your customized provider installation methods, OpenTofu was forced to",
        "calculate lock file checksums locally for the following providers:",
        "  - hashicorp/aws",
        "",
        "The current .terraform.lock.hcl file only includes checksums for",
        "darwin_arm64, so OpenTofu running on another platform will fail to install",
        "these providers.",
        "",
        "To calculate additional checksums for another platform, run:",
        "  tofu providers lock -platform=linux_amd64",
        "(where linux_amd64 is the platform to generate)",
        "",
        "OpenTofu has been successfully initialized!"
      ]
    },
    {
      "dir": "root",
      "run": [
        "tofu",
        "state",
        "replace-provider",
        "-auto-approve",
        "-no-color",
        "registry.opentofu.org/hashicorp/aws",
        "registry.compliance.tf/compliancetf/aws"
      ],
      "exit": 0,
      "output": [
        "OpenTofu will perform the following actions:",
        "",
        "  ~ Updating provider:",
        "    - registry.opentofu.org/hashicorp/aws",
        "    + registry.compliance.tf/compliancetf/aws",
        "",
        "Changing 5 resources:",
        "",
        "  module.own.fake_thing.o",
        "  module.own.fake_thing.oa",
        "  fake_thing.plain",
        "  fake_thing.aliased",
        "  module.inherits.fake_thing.m",
        "Successfully replaced provider for 5 resources."
      ]
    },
    {
      "dir": "root",
      "cat": "terraform.tfstate",
      "filter": "state_providers",
      "exit": 0,
      "output": [
        "fake_thing.aliased provider=provider[\"registry.compliance.tf/compliancetf/aws\"].west",
        "fake_thing.plain provider=provider[\"registry.compliance.tf/compliancetf/aws\"]",
        "module.inherits.fake_thing.m provider=provider[\"registry.compliance.tf/compliancetf/aws\"]",
        "module.own.fake_thing.o provider=module.own.provider[\"registry.compliance.tf/compliancetf/aws\"]",
        "module.own.fake_thing.oa provider=module.own.provider[\"registry.compliance.tf/compliancetf/aws\"].west"
      ]
    }
  ]
}
