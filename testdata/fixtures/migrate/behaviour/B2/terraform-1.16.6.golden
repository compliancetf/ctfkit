{
  "behavior": "B2",
  "assumption": "With implicit inheritance, that child module gets its own unconfigured hashicorp/aws instance; its resources bypass the wrapper",
  "cli": {
    "name": "terraform",
    "version": "1.16.6",
    "platform": "darwin_arm64",
    "binary_sha256": "27b7113783a1f7d71b711339bd235104961f7bcfe92dc6a9924206ee0eb75937",
    "release_archive": "terraform_1.16.6_darwin_arm64.zip",
    "release_archive_sha256": "85e1bc78ab45bdc5f82a7bac3929e37d072834a584d22583a2498dc67bb624cd"
  },
  "fake_provider_sha256": "dcb0571f6084f1d074a3ae02e0a8df62158e5eeb49b80e32d921e1b424eb9437",
  "upstream": "registry.terraform.io/hashicorp/aws",
  "inputs_sha256": "9836b88997da7ec2e389a25a21b5d2e1f8441e714aa2d060dc0f878dbd9f229c",
  "steps": [
    {
      "dir": "root",
      "run": [
        "terraform",
        "init",
        "-input=false",
        "-no-color"
      ],
      "exit": 0,
      "output": [
        "Initializing the backend...",
        "",
        "Initializing modules...",
        "- child in child",
        "",
        "Initializing provider plugins...",
        "- Finding latest version of registry.compliance.tf/compliancetf/aws...",
        "- Finding latest version of hashicorp/aws...",
        "- Installing registry.compliance.tf/compliancetf/aws v2.0.0...",
        "- Installed registry.compliance.tf/compliancetf/aws v2.0.0 (unauthenticated)",
        "- Installing hashicorp/aws v6.0.0...",
        "- Installed hashicorp/aws v6.0.0 (unauthenticated)",
        "",
        "Terraform has created a lock file .terraform.lock.hcl to record the provider",
        "selections it made above. Include this file in your version control repository",
        "so that Terraform can guarantee to make the same selections by default when",
        "you run \"terraform init\" in the future.",
        "",
        "",
        "Warning: Incomplete lock file information for providers",
        "",
        "Due to your customized provider installation methods, Terraform was forced to",
        "calculate lock file checksums locally for the following providers:",
        "  - hashicorp/aws",
        "  - registry.compliance.tf/compliancetf/aws",
        "",
        "The current .terraform.lock.hcl file only includes checksums for",
        "darwin_arm64, so Terraform running on another platform will fail to install",
        "these providers.",
        "",
        "To calculate additional checksums for another platform, run:",
        "  terraform providers lock -platform=linux_amd64",
        "(where linux_amd64 is the platform to generate)",
        "Terraform has been successfully initialized!"
      ]
    },
    {
      "dir": "root",
      "run": [
        "terraform",
        "providers",
        "-no-color"
      ],
      "exit": 0,
      "output": [
        "",
        "Providers required by configuration:",
        ".",
        "├── provider[registry.compliance.tf/compliancetf/aws]",
        "└── module.child",
        "    └── provider[registry.terraform.io/hashicorp/aws]"
      ]
    },
    {
      "dir": "root",
      "run": [
        "terraform",
        "plan",
        "-input=false",
        "-no-color",
        "-lock=false",
        "-out=p.tfplan"
      ],
      "exit": 0,
      "output": [
        "",
        "Terraform used the selected providers to generate the following execution",
        "plan. Resource actions are indicated with the following symbols:",
        "  + create",
        "",
        "Terraform will perform the following actions:",
        "",
        "  # fake_thing.r will be created",
        "  + resource \"fake_thing\" \"r\" {",
        "      + id   = (known after apply)",
        "      + name = \"r\"",
        "      + size = 1",
        "    }",
        "",
        "  # module.child.fake_thing.c will be created",
        "  + resource \"fake_thing\" \"c\" {",
        "      + id   = (known after apply)",
        "      + name = \"c\"",
        "      + size = 1",
        "    }",
        "",
        "Plan: 2 to add, 0 to change, 0 to destroy."
      ]
    },
    {
      "dir": "root",
      "run": [
        "terraform",
        "show",
        "-json",
        "-no-color",
        "p.tfplan"
      ],
      "filter": "plan_providers",
      "exit": 0,
      "output": [
        "provider_config aws full_name=registry.compliance.tf/compliancetf/aws configured=true",
        "provider_config module.child:aws full_name=registry.terraform.io/hashicorp/aws configured=false",
        "resource fake_thing.r provider=registry.compliance.tf/compliancetf/aws",
        "resource module.child.fake_thing.c provider=registry.terraform.io/hashicorp/aws"
      ]
    }
  ]
}
