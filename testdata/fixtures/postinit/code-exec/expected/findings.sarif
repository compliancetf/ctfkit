{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ctfkit",
          "informationUri": "https://github.com/compliancetf/ctfkit",
          "version": "1.0.0",
          "rules": [
            {
              "id": "ctf.coverage.manifest_missing",
              "shortDescription": {
                "text": "An instantiated module has no compliancetf-manifest.json"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "ctf.coverage.resource_unattested",
              "shortDescription": {
                "text": "The configuration declares its own resources and no imported test run covers them"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "ctf.exec.external_data",
              "shortDescription": {
                "text": "The configuration or a module it installs declares a data source that runs a local program"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "ctf.exec.module_endpoint",
              "shortDescription": {
                "text": "A module called from inside another module is installed from a source outside the allowed module endpoints"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "ctf.exec.provisioner",
              "shortDescription": {
                "text": "The configuration or a module it installs declares a provisioner"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "properties": {
        "ctf.catalogVersion": {
          "version": "2026.11.0",
          "origin": "embedded"
        }
      },
