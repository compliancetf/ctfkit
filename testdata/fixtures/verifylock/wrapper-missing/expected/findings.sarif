{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ctfkit",
          "informationUri": "https://github.com/compliancetf/ctfkit",
          "version": "1.0.0",
          "rules": [
            {
              "id": "ctf.lock.source_mismatch",
              "shortDescription": {
                "text": "A required_providers entry names, or a missing entry implies, the upstream source of a wrapped type"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "ctf.lock.upstream_present",
              "shortDescription": {
                "text": "The lock file installs the upstream provider of a wrapped type"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "ctf.lock.wrapper_missing",
              "shortDescription": {
                "text": "The lock file has no compliance.tf wrapper entry for a wrapped type the root uses"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ctf.lock.source_mismatch",
          "level": "error",
          "kind": "fail",
          "message": {
            "text": "required_providers names registry.terraform.io/hashicorp/aws; use registry.compliance.tf/compliancetf/aws"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.tf"
                },
                "region": {
                  "startLine": 4,
                  "endLine": 7
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "provider[\"registry.terraform.io/hashicorp/aws\"]",
                  "kind": "provider"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "ctfkitFindingHash/v1": "16fb66519d1864b8944e1a0bc6f885c98cb8231b1921ed893985a0aca23ed7ac"
          },
          "properties": {
            "ctf.schema": "1.0",
            "ctf.stage": "pre_plan",
            "ctf.controlIds": [],
            "ctf.frameworks": [],
            "ctf.preventive": false
          }
        },
        {
          "ruleId": "ctf.lock.upstream_present",
          "level": "error",
          "kind": "fail",
          "message": {
            "text": "Lock entry registry.terraform.io/hashicorp/aws installs the upstream aws provider, which bypasses the compliance.tf wrapper registry.compliance.tf/compliancetf/aws"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".terraform.lock.hcl"
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "provider[\"registry.terraform.io/hashicorp/aws\"]",
                  "kind": "provider"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "ctfkitFindingHash/v1": "b1908056638ce4aec95aea428b0348abc6bb9e52d7316c6c88ed5a056873b564"
          },
          "properties": {
            "ctf.schema": "1.0",
            "ctf.stage": "pre_plan",
            "ctf.controlIds": [],
            "ctf.frameworks": [],
            "ctf.preventive": false
          }
        },
        {
          "ruleId": "ctf.lock.wrapper_missing",
          "level": "error",
          "kind": "fail",
          "message": {
            "text": "Root . uses the aws provider but .terraform.lock.hcl has no registry.compliance.tf/compliancetf/aws entry"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".terraform.lock.hcl"
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "provider[\"registry.compliance.tf/compliancetf/aws\"]",
                  "kind": "provider"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "ctfkitFindingHash/v1": "77341aa37e7f068c18086b7e9299f560ef19ee32bee1b6fecb44708d7a080c01"
          },
          "properties": {
            "ctf.schema": "1.0",
            "ctf.stage": "pre_plan",
            "ctf.controlIds": [],
            "ctf.frameworks": [],
            "ctf.preventive": false
          }
        }
      ]
    }
  ]
}
