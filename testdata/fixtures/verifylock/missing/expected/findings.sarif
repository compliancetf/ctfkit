{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ctfkit",
          "informationUri": "https://github.com/compliancetf/ctfkit",
          "version": "1.0.0",
          "rules": [
            {
              "id": "ctf.lock.missing",
              "shortDescription": {
                "text": "A deployable root has no dependency lock file"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ctf.lock.missing",
          "level": "error",
          "kind": "fail",
          "message": {
            "text": "Root envs/dev has no .terraform.lock.hcl, so terraform init picks the providers it installs"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "envs/dev/.terraform.lock.hcl"
                }
              }
            }
          ],
          "partialFingerprints": {
            "ctfkitFindingHash/v1": "de2182e86e78975b3c199a2bfdc816165d2e7fbd6300a08c3597eebeeb9c6b71"
          },
          "properties": {
            "ctf.schema": "1.0",
            "ctf.stage": "pre_plan",
            "ctf.controlIds": [],
            "ctf.frameworks": [],
            "ctf.preventive": false
          }
        }
      ]
    }
  ]
}
